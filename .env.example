# Environment Variables for Dr. Fatemeh Momeni Medical Platform

# Web3Forms API Key for booking notifications (Optional)
VITE_WEB3FORMS_KEY=

# Google Sheets Webhook URL for appointment syncing (Optional)
VITE_SHEETS_WEBHOOK_URL=

# Telegram Bot Integration for instant clinic notifications (Optional)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Server-Side Gemini API Key (Optional)
GEMINI_API_KEY=
